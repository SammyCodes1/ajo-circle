# Public config only — NEVER put secret keys in NEXT_PUBLIC_* variables.
# Values below are the Ajo Circle testnet deployment (see deployments/testnet.env).
NEXT_PUBLIC_AJO_CONTRACT_ID=CBH6266NK6UGOLQ6NEUWM7EYANTMHOB5CLCJ27LZ3ARAARP52CIST4EZ
NEXT_PUBLIC_TOKEN_CONTRACT_ID=CATRFP36R3S26TGC2W5VQKV7ZFWKQ2B2HAJI6RXUTSB442UBTPJDO5MB
NEXT_PUBLIC_TOKEN_CODE=USDC
NEXT_PUBLIC_TOKEN_ISSUER=GDV2MVS4BPWM7E2MHVVPLEVYJL2EMOSHZEAK4OV4YYTPSAQ4QFV3NDAA
NEXT_PUBLIC_RPC_URL=https://soroban-testnet.stellar.org
NEXT_PUBLIC_HORIZON_URL=https://horizon-testnet.stellar.org
NEXT_PUBLIC_NETWORK_PASSPHRASE=Test SDF Network ; September 2015
# Any funded public account; used only as the source for read-only simulations.
NEXT_PUBLIC_READ_ACCOUNT=GAE35JYI64GESADTMBWWN4C7RMKE6L7OHLGNRDZQWSLV5OI32IRSRIZX
# Optional: enable WalletConnect in the wallet picker (free project id from https://cloud.reown.com).
# REQUIRED for Freighter mobile's in-app browser, which only connects via WalletConnect.
# Leave empty to omit WalletConnect. Rebuild after changing.
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# Optional, SERVER-ONLY (never prefix with NEXT_PUBLIC_): secret key of a TESTNET-ONLY distributor
# account that holds test USDC (trustline + balance). Enables /api/faucet ("Get test USDC" and
# auto-funding of the built-in testnet wallet). Leave unset to hide the faucet.
FAUCET_SECRET=
# Optional: test USDC per faucet request (default 100).
FAUCET_AMOUNT=
